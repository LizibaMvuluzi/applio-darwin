{
  "_comment": "Copie ce fichier en config.json et ajuste si tes chemins Drive diffèrent. config.json n'est jamais versionné (voir .gitignore).",

  "model_name": "darwin",

  "drive": {
    "root": "/content/drive/MyDrive",
    "backup_folder": "ApplioBackup",
    "dataset_folder": "Darwin_Dataset",
    "export_folder": "ApplioExported",
    "input_audio": "ma_voix.wav"
  },

  "applio": {
    "install_dir": "/content/Applio",

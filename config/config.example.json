{
  "_comment": "Copie ce fichier en config.json. config.json n'est jamais versionné. Le projet est verrouillé sur le modèle darwin.",
  "model_name": "darwin",
  "drive": {
    "root": "/content/drive/MyDrive",
    "backup_folder": "ApplioBackup",
    "dataset_folder": "Darwin_Dataset",

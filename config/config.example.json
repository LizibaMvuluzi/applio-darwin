    "sample_rate": "40k",
    "f0_method": "rmvpe",
    "embedder_model": "contentvec",
    "total_epoch": 800,
    "batch_size": 8,
    "save_every_epoch": 10,
    "vocoder": "HiFi-GAN"
  }
